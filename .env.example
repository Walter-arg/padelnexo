# La configuracion de Firebase (apiKey, authDomain, etc.) esta hardcodeada
# en services/firebaseConfig.js, no se lee desde variables de entorno. Es la
# apiKey publica del cliente (no es secreta), por eso vive directo en el
# codigo. Aca solo va lo que la app realmente lee de process.env.

EXPO_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxx

# API keys publicas de RevenueCat (una por plataforma, no son secretas:
# identifican la app ante RevenueCat, la validacion real ocurre server-side).
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxx
