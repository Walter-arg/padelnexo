MERCADO_PAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxx
MERCADO_PAGO_WEBHOOK_URL=https://southamerica-east1-your-project.cloudfunctions.net/mercadoPagoWebhook
MERCADO_PAGO_STATEMENT_DESCRIPTOR=PADELNEXO
# Usado por sendWelcomeEmail, sendPasswordReset, sendPlanActivationEmail,
# sendPlanExpirationWarning (via checkPlanExpirations), assignOrganizerPlan
# y approveOrganizerRequest para mandar emails con Resend:
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opcional por ahora, recomendado para produccion y simulaciones desde "Tus integraciones":
# MERCADO_PAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Header "Authorization" configurado en el webhook de RevenueCat (dashboard >
# Project settings > Integrations > Webhooks). Cualquier string secreto sirve,
# solo tiene que coincidir en los dos lados:
REVENUECAT_WEBHOOK_AUTH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opcionales para una futura etapa OAuth / marketplace:
# MERCADO_PAGO_CLIENT_ID=1234567890123456
# MERCADO_PAGO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MERCADO_PAGO_OAUTH_REDIRECT_URL=https://southamerica-east1-your-project.cloudfunctions.net/mercadoPagoOAuthRedirect
# MERCADO_PAGO_OAUTH_TEST_TOKEN=true
# MERCADO_PAGO_CHECKOUT_SANDBOX=true
# MERCADO_PAGO_USE_LINKED_ACCOUNTS=false
# MERCADO_PAGO_REQUIRE_LINKED_ACCOUNTS=true
