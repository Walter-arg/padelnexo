rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isOrganizer(resource) {
      return isAuth() && (
        resource.data.organizerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid
      );
    }

    function esAdmin() {
      return isAuth() && (
        request.auth.token.email.lower() == "wramirez.arg@gmail.com" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminStatus == "active"
      );
    }

    // Campos sensibles del perfil que un usuario NO puede tocar libremente
    // (rol, aprobacion de organizador, plan pago, estado admin, bloqueo, email).
    function unchangedField(field, defaultValue) {
      return request.resource.data.get(field, defaultValue) ==
        resource.data.get(field, defaultValue);
    }

    function isSafeUserSelfUpdate() {
      return
        unchangedField('adminStatus', 'none') &&
        unchangedField('plan', null) &&
        unchangedField('planStatus', 'none') &&
        unchangedField('blockStatus', 'none') &&
        (
          (unchangedField('role', 'user') && unchangedField('organizerStatus', 'none')) ||
          (
            // Unica transicion permitida por el propio usuario: pedir ser organizador.
            request.resource.data.get('role', 'user') == 'organizer' &&
            request.resource.data.get('organizerStatus', 'none') == 'pending' &&
            resource.data.get('role', 'user') == 'user'
          )
        ) &&
        (
          unchangedField('email', '') ||
          request.resource.data.email == request.auth.token.email
        );
    }

    function isSafeUserCreate() {
      return
        request.resource.data.get('role', 'user') == 'user' &&
        request.resource.data.get('organizerStatus', 'none') == 'none' &&
        request.resource.data.get('adminStatus', 'none') == 'none' &&
        request.resource.data.get('plan', null) == null &&
        request.resource.data.get('planStatus', 'none') == 'none' &&
        request.resource.data.get('blockStatus', 'none') == 'none';
    }

    // Perfiles de usuario
    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isUser(userId) && isSafeUserCreate();
      allow update: if isUser(userId) && isSafeUserSelfUpdate();
      allow delete: if isUser(userId);

      // Email y telefono real: solo el dueño puede leerlos/escribirlos. El
      // panel de admin los lee via Cloud Function (Admin SDK), no desde aca.
      match /private/{document} {
        allow read, write: if isUser(userId);
      }
    }

    // Ligas
    match /leagues/{leagueId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isOrganizer(resource);
    }

    // Torneos y subcolecciones
    match /tournaments/{tournamentId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isOrganizer(resource);

      match /registrations/{regId} {
        allow read: if isAuth();
        allow create: if isAuth();
        allow update, delete: if isAuth() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerId == request.auth.uid ||
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.createdBy == request.auth.uid
        );
      }

      match /groups/{groupId} {
        allow read: if isAuth();
        allow write: if isAuth() && (
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerId == request.auth.uid ||
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.createdBy == request.auth.uid
        );
      }

      match /matches/{matchId} {
        allow read: if isAuth();
        allow write: if isAuth() && (
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerId == request.auth.uid ||
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.createdBy == request.auth.uid
        );
      }

      match /notifications/{notifId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerId == request.auth.uid ||
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.createdBy == request.auth.uid
        );
        allow create: if isAuth() && (
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.organizerId == request.auth.uid ||
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.createdBy == request.auth.uid
        );
      }
    }

    // Reservas y configuraciones de turnos
    function esDuenioDeReserva(data) {
      return data.playerId == request.auth.uid || data.organizerId == request.auth.uid;
    }

    match /turnoReservations/{reservationId} {
      // La lectura queda abierta a cualquier autenticado porque la app necesita
      // ver TODAS las reservas proximas (de cualquier jugador/organizador) para
      // calcular que horarios estan libres al mostrar turnos disponibles.
      allow read: if isAuth();
      allow update, delete: if isAuth() && esDuenioDeReserva(resource.data);
      allow create: if isAuth() && esDuenioDeReserva(request.resource.data);
    }

    match /turnosConfigs/{configId} {
      allow read: if isAuth();
      allow write: if isAuth() && request.auth.uid == configId;
    }

    // Solicitudes de inscripción a ligas
    match /leagueRegistrationRequests/{requestId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        resource.data.organizerId == request.auth.uid
      );
    }

    // Conversaciones — solo participantes mayores de 14, o usuarios con rol organizador
    function chatHabilitadoParaUsuario() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.chatHabilitado == true;
    }

    function esOrganizador() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "organizer";
    }

    function puedeUsarChat() {
      return chatHabilitadoParaUsuario() || esOrganizador();
    }

    function esConversacionDelSistema(participants) {
      return "padelnexo-system" in participants;
    }

    match /conversations/{conversationId} {
      allow read: if isAuth() &&
        request.auth.uid in resource.data.participants &&
        (puedeUsarChat() || esConversacionDelSistema(resource.data.participants));
      allow write: if isAuth() &&
        puedeUsarChat() &&
        (request.auth.uid in resource.data.participants ||
         (esConversacionDelSistema(resource.data.participants) &&
          request.resource.data.lastMessageSenderId == "padelnexo-system"));
      allow create: if isAuth() && puedeUsarChat();

      match /messages/{messageId} {
        allow read: if isAuth() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          (puedeUsarChat() || esConversacionDelSistema(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          ));
        allow create: if isAuth() && puedeUsarChat();
      }
    }

    // Invitaciones
    match /invitations/{invitationId} {
      allow read: if isAuth() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isAuth();
      allow update, delete: if isAuth() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    // Favoritos de ligas
    match /leagueFavorites/{favoriteId} {
      allow read, write: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth();
    }

    // Solicitudes de complejo
    match /complexRequests/{requestId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || esAdmin());
      allow create: if isAuth();
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Solicitudes de organizador
    match /organizerRequests/{requestId} {
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || esAdmin());
      allow create: if isAuth();
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Reportes
    match /reports/{reportId} {
      allow create: if isAuth();
      allow read, update, delete: if isAuth() &&
        (resource.data.reporterId == request.auth.uid || esAdmin());
    }

    // Bloqueos entre usuarios
    match /userBlocks/{blockId} {
      allow read, write: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth();
    }

    // Configuracion de la app (version minima, etc.)
    match /appConfig/{document} {
      allow read: if true;
    }

    // Emails de cuentas eliminadas por un admin: el cliente solo puede
    // consultar un email puntual (para el chequeo al registrarse), nunca
    // listar la coleccion completa ni escribirla. Solo la Cloud Function
    // deleteUserAccount (Admin SDK) escribe aca.
    match /blockedEmails/{email} {
      allow get: if isAuth();
      allow list: if false;
      allow write: if false;
    }
  }
}
